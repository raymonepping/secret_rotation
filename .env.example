# .env — local overrides and secrets. Never committed.
# `make env-init` copies this file to .env and fills every empty *_PASSWORD.
# Image pins, ports and names live in config/defaults.env; override them here.

# PostgreSQL superuser (container bootstrap and `make psql` only; Vault never uses it).
POSTGRES_SUPERUSER_PASSWORD=

# Only when VAULT_IMAGE points at a Vault Enterprise image:
# VAULT_IMAGE=docker.io/hashicorp/vault-enterprise:2.1.1-ent
# VAULT_LICENSE=
