# secret-theatre-api — the API's identity (AppRole secret-theatre-api).
# Exactly what the three lanes call, nothing else. Rendered by Terraform
# (terraform/vault-platform) with the names from config/defaults.env.

# Patient lane: a dynamic credential, and revoking its lease.
path "database/creds/${dynamic_role}" {
  capabilities = ["read"]
}

path "sys/leases/revoke" {
  capabilities = ["update"]
}

# Surgeon lane: read the static role's current password, rotate it now.
path "database/static-creds/${static_role}" {
  capabilities = ["read"]
}

path "database/rotate-role/${static_role}" {
  capabilities = ["update"]
}

# Doctor lane: rotate the connection's own (root) credential.
path "database/rotate-root/${connection}" {
  capabilities = ["update"]
}
