# config/defaults.env — tracked defaults for image pins, host ports and names.
# scripts/compose.sh loads this file first and .env second, so any value can
# be overridden in .env without editing a compose file. scripts/common.sh and
# scripts/ports-check.sh read the same names.

# ── Images ────────────────────────────────────────────────────────────────────
# Vault Community (decision D1). Point at an Enterprise image in .env and set
# VAULT_LICENSE there if you need Enterprise features.
VAULT_IMAGE=docker.io/hashicorp/vault:2.0.0
POSTGRES_IMAGE=docker.io/library/postgres:16.14-alpine
NODE_IMAGE=docker.io/library/node:24-alpine
NGINX_IMAGE=docker.io/library/nginx:1.30.0-alpine
ALPINE_IMAGE=docker.io/library/alpine:3.24.1
VAULT_LICENSE=

# ── Host ports (all published on 127.0.0.1) ───────────────────────────────────
# Chosen to run beside vault_reference (8190-8212, 5432, 3001, 8080, 8443).
SROT_PORT_VAULT_S=18190
SROT_PORT_VAULT_1=18200
SROT_PORT_POSTGRES=15432
SROT_PORT_API=13000
SROT_PORT_WEB=13001
# `npm run dev` in app/web (Vite); the API allows it as a CORS origin.
SROT_PORT_WEB_DEV=5173

# ── Names (decision D4) ───────────────────────────────────────────────────────
SROT_DB_NAME=hospital
SROT_DB_CONNECTION=hospital-postgres
SROT_DB_ROLE_DYNAMIC=patient-readonly
SROT_DB_ROLE_STATIC=surgeon
SROT_DB_STATIC_USER=surgeon_svc
SROT_DB_MGMT_USER=vault_mgmt
